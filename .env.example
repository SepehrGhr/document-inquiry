DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=documents
POSTGRES_USER=documents
POSTGRES_PASSWORD=documents
POSTGRES_HOST=db
POSTGRES_PORT=5432

# RAG. The embedding model is fixed by the index profile row, not by env vars;
# changing it means creating a new profile and rebuilding the index.
CELERY_BROKER_URL=redis://redis:6379/0
RAG_ACTIVE_PROFILE=jina-v3
RAG_AUTO_INDEX=true
RAG_TOP_K=5

# Embeddings: Jina (preferred) or OpenRouter.
JINA_KEY=
RAG_JINA_BASE_URL=https://api.jina.ai/v1
OPENROUTER_KEY=
RAG_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Answer generation.
RAG_ANSWER_PROVIDER=openrouter
RAG_ANSWER_MODEL=stealth/crouton-alpha
RAG_ANSWER_TIMEOUT=60
RAG_EMBEDDING_TIMEOUT=60

# Disk cache for embeddings; set to false to always call the provider.
RAG_EMBEDDING_CACHE=true
RAG_EMBEDDING_CACHE_DIR=.cache/embeddings
